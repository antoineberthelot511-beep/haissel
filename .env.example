# Copiez ce fichier en .env puis remplacez TOUTES les valeurs d'exemple.
# Ne versionnez jamais .env.

NODE_ENV=development
PORT=3000

# Domaine e-mail autorisé à l'inscription (vide = toutes les adresses).
ALLOWED_EMAIL_DOMAIN=

# Secret de signature des sessions : au moins 32 octets aléatoires.
# PowerShell : [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=local-development-only-secret-replace-before-production-123456

# PostgreSQL (npm start : host localhost ; Docker : host db)
POSTGRES_DB=lycee_social
POSTGRES_USER=lycee_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://lycee_user:change_me@localhost:5432/lycee_social
DATABASE_SSL=false

# Webhook de conversion des partenaires (au moins 32 caractères).
# Vide = webhook désactivé. Secret propre à un partenaire possible :
# AFFILIATE_WEBHOOK_SECRET_<NOM_DU_PARTENAIRE>=...
AFFILIATE_WEBHOOK_SECRET=

# Docker uniquement : secret partagé entre Nginx et l'application (32+ caractères).
PROXY_SHARED_SECRET=
# Ports Docker : espace utilisateur (réseau local) et administration (127.0.0.1 seulement).
PUBLIC_PORT=3000
ADMIN_PORT=3001

# Origines supplémentaires autorisées en CORS (inutile en usage normal, même origine).
CORS_ORIGINS=

# Réactive les anciennes API du réseau social (posts, messages…). Désactivé par défaut.
ENABLE_LEGACY_SOCIAL_API=false
