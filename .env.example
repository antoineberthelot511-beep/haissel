# Copiez ce fichier en .env puis remplacez TOUTES les valeurs d'exemple.
# Ne versionnez jamais .env.

NODE_ENV=development
PORT=3000

# Domaine e-mail autorisé à l'inscription (vide = toutes les adresses).
ALLOWED_EMAIL_DOMAIN=

# Secret maître (au moins 32 octets aléatoires). Les clés CSRF, d'empreinte
# IP et de chiffrement MFA en sont dérivées. JWT_SECRET reste accepté à la
# place d'APP_SECRET pour les installations existantes.
# PowerShell : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
APP_SECRET=local-development-only-secret-replace-before-production-123456

# Clé de chiffrement indépendante pour les secrets de double authentification
# (optionnelle ; sinon dérivée d'APP_SECRET). Au moins 32 octets.
MFA_ENCRYPTION_KEY=

# Double authentification obligatoire pour les administrateurs (recommandé).
ADMIN_REQUIRE_MFA=true

# Cookie de session : auto (Secure si la requête arrive en HTTPS) | true | false.
# En production derrière HTTPS : true.
COOKIE_SECURE=auto

# PostgreSQL (npm start : host localhost ; Docker : host db)
POSTGRES_DB=lycee_social
POSTGRES_USER=lycee_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://lycee_user:change_me@localhost:5432/lycee_social
DATABASE_SSL=false

# ---- E-mails (vérification d'adresse, mot de passe oublié) ----
# none    : aucun envoi ; vérification et « mot de passe oublié » désactivés
# smtp    : envoi réel (paramètres SMTP ci-dessous)
# console : développement uniquement, le message s'affiche dans la console
MAIL_TRANSPORT=none
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Adresse publique utilisée dans les liens envoyés par e-mail
# (ex. http://192.168.1.17:3000). Vide = adresse réseau détectée.
APP_PUBLIC_URL=
# Mettre "off" pour ne pas exiger la vérification même si l'envoi est configuré.
EMAIL_VERIFICATION=

# Webhook de conversion des partenaires (au moins 32 caractères).
AFFILIATE_WEBHOOK_SECRET=

# Docker uniquement : secret partagé entre Nginx et l'application (32+ caractères).
PROXY_SHARED_SECRET=
PUBLIC_PORT=3000
ADMIN_PORT=3001

# HTTPS natif pour « npm start » (chemins HORS du dépôt, voir README).
# Requis pour les notifications système sur les autres PC du réseau.
# Exemple : HTTPS_CERT_FILE=C:\chemin\vers\haissel.pem (fichiers mkcert).
# Avec HTTPS, mettre aussi COOKIE_SECURE=true ; sans HTTPS, remettre auto.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Notifications temps réel (valeurs par défaut adaptées à un seul processus).
REALTIME_MAX_PER_USER=5
REALTIME_MAX_TOTAL=2000

CORS_ORIGINS=
ENABLE_LEGACY_SOCIAL_API=false
