NODE_ENV=production
PORT=3000
ALLOWED_EMAIL_DOMAIN=

# Valeurs à générer : au moins 32 octets aléatoires chacune, uniques par serveur.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BEFORE_STARTING
AFFILIATE_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PROXY_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

POSTGRES_DB=lycee_social
POSTGRES_USER=lycee_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgres://lycee_user:CHANGE_ME_IN_PRODUCTION@db:5432/lycee_social
DATABASE_SSL=false

PUBLIC_PORT=3000
ADMIN_PORT=3001
CORS_ORIGINS=
ENABLE_LEGACY_SOCIAL_API=false
