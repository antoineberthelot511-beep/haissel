{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/**",
          "database/**",
          "node_modules/@fontsource/**",
          "node_modules/@fontsource-variable/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/app.js" }
  ],
  "crons": [
    { "path": "/api/internal/retention", "schedule": "0 3 * * *" }
  ]
}
