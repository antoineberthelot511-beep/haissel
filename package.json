{
  "name": "haissel",
  "version": "1.1.0",
  "description": "HAISSEL - plateforme d'affiliation (Express, PostgreSQL).",
  "private": true,
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "migrate": "node scripts/migrate.js",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/check-syntax.js && jest --runInBand",
    "test:unit": "jest --runInBand tests/unit.test.js",
    "test:integration": "jest --runInBand tests/integration.test.js",
    "admin:promote": "node scripts/promote-admin.js",
    "webhook:test": "node scripts/sign-webhook.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "vercel-build": "node scripts/vercel-build.js",
    "tuto:build": "node scripts/tuto-build.js"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testTimeout": 20000,
    "forceExit": true
  },
  "keywords": [
    "affiliation",
    "express",
    "postgres"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sharp": "^0.34.2",
    "supertest": "^7.0.0"
  }
}
